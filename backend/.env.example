DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/ecommerce_db
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated allowed origins. Add your LAN IP (e.g. http://192.168.1.77:5173)
# if you open the Vite dev server from a phone or another machine on the same network.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used only by `python -m app.seed` to create the admin account
ADMIN_EMAIL=admin@shoply.dev
ADMIN_PASSWORD=ChangeMe123!

# ==================================================
# Milestone 2 - AI / RAG Configuration
# ==================================================
# Every value below is intentionally left EMPTY in this example file.
# Never put real API keys in .env.example - it is committed to Git.
# Copy the real keys into backend/.env, which is gitignored.
# The app boots and serves Milestone 1 normally with all of these blank;
# only /api/chat and the RAG route are disabled until they are filled in.


# ------------------------------
# Groq LLM
# ------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant


# ------------------------------
# Hugging Face Embeddings
# ------------------------------
HF_API_KEY=
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# ------------------------------
# Qdrant Cloud
# ------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ecommerce_knowledge


# ------------------------------
# Optional tuning
# ------------------------------
# Not required to enable the chatbot - shown so every setting in
# app/config.py has a documented entry here. Delete a line to fall
# back to its default in the Settings class.

# Groq
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800

# Hugging Face
# Base for model serving. api-inference.huggingface.co was retired and no
# longer resolves; the router is the current endpoint.
HF_API_URL=https://router.huggingface.co/hf-inference
HF_EMBED_BATCH_SIZE=16

# RAG pipeline
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
# Folder scanned by `python -m app.ai.rag`
RAG_DOCUMENTS_DIR=documents
RAG_MAX_UPLOAD_MB=10

# Chat behaviour
ROUTER_CONFIDENCE_THRESHOLD=0.80
CHAT_MAX_MESSAGE_LENGTH=1000
